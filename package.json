{
  "name": "low-cost-health-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/browser-test-server.mjs",
    "dev:network": "HOST=0.0.0.0 node ./scripts/browser-test-server.mjs",
    "test": "vitest run",
    "test:clinical-review": "vitest run tests/clinical-safety/clinical-review-scenarios.test.ts --reporter=verbose",
    "test:browser": "node ./scripts/playwright-runner.mjs",
    "typecheck": "tsc --noEmit",
    "build:verify": "node ./scripts/production-build-verify.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "fake-indexeddb": "^6.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
